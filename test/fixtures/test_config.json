  "validation_rules": {
    "required_fields": {
      "items": ["name", "location", "total_quantity", "unit"],
      "containers": ["name", "type", "location"],
      "assignments": ["item_id", "container_id", "quantity"]
    },
    "data_constraints": {
      "quantity_min": 0,
      "quantity_max": 999999,
      "name_max_length": 100,
      "description_max_length": 500
    },
    "dangerous_goods_classes": [
